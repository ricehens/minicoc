False : *
False = Π (P: *). P

⊨ : Π (W: *). (W → *) → *
⊨ = λ (W: *) (P: W → *). Π (w: W). P w

⊥ : Π (W: *). (W → *)
⊥ = λ (W: *) (w: W). False

⊃ : Π (W: *). (W → *) → (W → *) → (W → *)
⊃ = λ (W: *) (P: W → *) (Q: W → *) (w: W). P w → Q w

¬ : Π (W: *). (W → *) → (W → *)
¬ = λ (W: *) (P: W → *). ⊃ W P (⊥ W)

Con : Π (W: *) (☐: (W → *) → (W → *)). (W → *)
Con = λ (W: *) (☐: (W → *) → (W → *)). ¬ W (☐ (⊥ W))


#define AXIOMS \
    (W: *) (☐: (W → *) → (W → *)) \
    (HB1: Π (P: W → *). ⊨ W P → ⊨ W (☐ P)) \
    (HB2: Π (P: W → *) (w: W). ☐ P w → ☐ (☐ P) w) \
    (HB3: Π (P: W → *) (Q: W → *) (w: W). ☐ (⊃ W P Q) w → ☐ P w → ☐ Q w) \
    (φ: W → *) \
    (G1: ⊨ W (⊃ W φ (¬ W (☐ φ)))) \
    (G2: ⊨ W (⊃ W (¬ W (☐ φ)) φ))

#define ARGS W ☐ HB1 HB2 HB3 φ G1 G2


-- Lemma 1: ⊢ ☐(φ → ¬☐φ)
Lemma1 : Π AXIOMS. ⊨ W (☐ (⊃ W φ (¬ W (☐ φ))))
Lemma1 = λ AXIOMS. HB1 (⊃ W φ (¬ W (☐ φ))) G1


-- Lemma 2: ⊢ ☐φ → ☐(¬☐φ)
Lemma2 : Π AXIOMS. ⊨ W (⊃ W (☐ φ) (☐ (¬ W (☐ φ))))
Lemma2 = λ AXIOMS. 
         λ (w: W) (x: ☐ φ w).
         HB3 φ (¬ W (☐ φ)) w (Lemma1 ARGS w) x


-- Lemma 3: ⊢ ☐φ → ☐⊥
Lemma3 : Π AXIOMS. ⊨ W (⊃ W (☐ φ) (☐ (⊥ W)))
Lemma3 = λ AXIOMS. 
         λ (w: W) (x: ☐ φ w).
         HB3 (☐ φ) (⊥ W) w (Lemma2 ARGS w x) (HB2 φ w x)


-- Thmb G1a: ⊢ Consistency → ¬☐φ
ThmG1a : Π AXIOMS. ⊨ W (⊃ W (Con W ☐) (¬ W (☐ φ)))
ThmG1a = λ AXIOMS. 
         λ (w: W) (C: Con W ☐ w) (x: ☐ φ w).
         C (Lemma3 ARGS w x)


-- Thm G1b: ⊢ Consistency → φ
ThmG1b : Π AXIOMS. ⊨ W (⊃ W (Con W ☐) φ)
ThmG1b = λ AXIOMS. 
         λ (w: W) (C: Con W ☐ w).
         G2 w (ThmG1a ARGS w C)


-- Lemma 4: ⊢ ☐(Consistency → φ)
Lemma4 : Π AXIOMS. ⊨ W (☐ (⊃ W (Con W ☐) φ))
Lemma4 = λ AXIOMS. 
         HB1 (⊃ W (Con W ☐) φ) (ThmG1b ARGS)


-- Lemma 5: ⊢ ☐Consistency → ☐φ
Lemma5 : Π AXIOMS. ⊨ W (⊃ W (☐ (Con W ☐)) (☐ φ))
Lemma5 = λ AXIOMS. 
         λ (w: W) (x: ☐ (Con W ☐) w).
         HB3 (Con W ☐) φ w (Lemma4 ARGS w) x


-- Thm G2: ⊢ ☐Consistency → ☐⊥
ThmG2 : Π AXIOMS. ⊨ W (⊃ W (☐ (Con W ☐)) (☐ (⊥ W)))
ThmG2 = λ AXIOMS. 
        λ (w: W) (x: ☐ (Con W ☐) w).
        Lemma3 ARGS w (Lemma5 ARGS w x)
