-- Leibniz Equality
Eq : Π (T: *). T → T → *
Eq = λ (T: *) (x: T) (y: T).
     Π (P: T → *). P x → P y

-- Reflexivity: x == x
refl : Π (T: *) (x: T). Eq T x x
refl = λ (T: *) (x: T) (P: T → *) (Hx: P x). Hx

-- Symmetry: If x == y, then y == x
sym : Π (T: *) (x: T) (y: T). Eq T x y → Eq T y x
sym = λ (T: *) (x: T) (y: T) (Hxy: Eq T x y).
      Hxy (λ (z: T). Eq T z x) (refl T x)

-- Transitivity: If x == y and y == z, then x == z
trans : Π (T: *) (x: T) (y: T) (z: T). Eq T x y → Eq T y z → Eq T x z
trans = λ (T: *) (x: T) (y: T) (z: T) (Hxy: Eq T x y) (Hyz: Eq T y z).
        Hyz (λ (w: T). Eq T x w) Hxy

-- Left Congruence: If x == y, then c * x == c * y
congrL : Π (T: *) (op: T → T → T) (c: T) (x: T) (y: T). Eq T x y → Eq T (op c x) (op c y)
congrL = λ (T: *) (op: T → T → T) (c: T) (x: T) (y: T) (Hxy: Eq T x y).
         Hxy (λ (z: T). Eq T (op c x) (op c z)) (refl T (op c x))

-- Right Congruence: If x == y, then x * c == y * c
congrR : Π (T: *) (op: T → T → T) (x: T) (y: T) (c: T). Eq T x y → Eq T (op x c) (op y c)
congrR = λ (T: *) (op: T → T → T) (x: T) (y: T) (c: T) (Hxy: Eq T x y).
         Hxy (λ (z: T). Eq T (op x c) (op z c)) (refl T (op x c))


#define AXIOMS \
    (G: *) (op: G → G → G) (id: G) (inv: G → G) \
    (assoc: Π (x: G) (y: G) (z: G). Eq G (op (op x y) z) (op x (op y z))) \
    (idL:   Π (x: G). Eq G (op id x) x) \
    (idR:   Π (x: G). Eq G (op x id) x) \
    (invL:  Π (x: G). Eq G (op (inv x) x) id) \
    (invR:  Π (x: G). Eq G (op x (inv x)) id)

#define ARGS G op id inv assoc idL idR invL invR


-- Uniqueness of Identity
unique_id : Π AXIOMS.
            Π (b: G) (c: G)
              (H1: Π (a: G). Eq G (op b a) a)
              (H2: Π (a: G). Eq G (op a c) a).
            Eq G b c
unique_id = λ AXIOMS.
            λ (b: G) (c: G)
              (H1: Π (a: G). Eq G (op b a) a)
              (H2: Π (a: G). Eq G (op a c) a).
            trans G b (op b c) c
              (sym G (op b c) b (H2 b))
              (H1 c)


-- Uniqueness of Inverse
unique_inv : Π AXIOMS.
             Π (a: G) (b: G) (c: G)
               (H1: Eq G (op b a) id)
               (H2: Eq G (op a c) id).
             Eq G b c
unique_inv = λ AXIOMS.
             λ (a: G) (b: G) (c: G)
               (H1: Eq G (op b a) id)
               (H2: Eq G (op a c) id).
             trans G b (op b id) c
               (sym G (op b id) b (idR b))
               (trans G (op b id) (op b (op a c)) c
                 (congrL G op b id (op a c) (sym G (op a c) id H2))
                 (trans G (op b (op a c)) (op (op b a) c) c
                   (sym G (op (op b a) c) (op b (op a c)) (assoc b a c))
                   (trans G (op (op b a) c) (op id c) c
                     (congrR G op (op b a) id c H1)
                     (idL c)
                   )
                 )
               )


-- Left Cancellation
left_cancel : Π AXIOMS.
              Π (a: G) (b: G) (c: G)
                (Hyp: Eq G (op a b) (op a c)).
              Eq G b c
left_cancel = λ AXIOMS.
              λ (a: G) (b: G) (c: G)
                (Hyp: Eq G (op a b) (op a c)).
              trans G b (op id b) c
                (sym G (op id b) b (idL b))
                (trans G (op id b) (op (op (inv a) a) b) c
                  (congrR G op id (op (inv a) a) b (sym G (op (inv a) a) id (invL a)))
                  (trans G (op (op (inv a) a) b) (op (inv a) (op a b)) c
                    (assoc (inv a) a b)
                    (trans G (op (inv a) (op a b)) (op (inv a) (op a c)) c
                      (congrL G op (inv a) (op a b) (op a c) Hyp)
                      (trans G (op (inv a) (op a c)) (op (op (inv a) a) c) c
                        (sym G (op (op (inv a) a) c) (op (inv a) (op a c)) (assoc (inv a) a c))
                        (trans G (op (op (inv a) a) c) (op id c) c
                          (congrR G op (op (inv a) a) id c (invL a))
                          (idL c)
                        )
                      )
                    )
                  )
                )


-- Inverse of Inverse
inv_of_inv : Π AXIOMS. 
             Π (a: G). Eq G (inv (inv a)) a
inv_of_inv = λ AXIOMS. 
             λ (a: G).
             unique_inv ARGS
               (inv a) 
               (inv (inv a)) 
               a
               (invL (inv a))
               (invL a)


-- Socks and Shoes
socks_and_shoes : Π AXIOMS. 
                  Π (a: G) (b: G). Eq G (inv (op a b)) (op (inv b) (inv a))
socks_and_shoes = λ AXIOMS. 
                  λ (a: G) (b: G).
                  unique_inv ARGS
                    (op a b)
                    (inv (op a b))
                    (op (inv b) (inv a))
                    (invL (op a b))
                    (trans G (op (op a b) (op (inv b) (inv a))) (op a (op b (op (inv b) (inv a)))) id
                      (assoc a b (op (inv b) (inv a)))
                      (trans G (op a (op b (op (inv b) (inv a)))) (op a (inv a)) id
                        (congrL G op a (op b (op (inv b) (inv a))) (inv a)
                          (trans G (op b (op (inv b) (inv a))) (op (op b (inv b)) (inv a)) (inv a)
                            (sym G (op (op b (inv b)) (inv a)) (op b (op (inv b) (inv a))) (assoc b (inv b) (inv a)))
                            (trans G (op (op b (inv b)) (inv a)) (op id (inv a)) (inv a)
                              (congrR G op (op b (inv b)) id (inv a) (invR b))
                              (idL (inv a))
                            )
                          )
                        )
                        (invR a)
                      )
                    )
