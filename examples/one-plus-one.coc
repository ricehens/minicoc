Nat : *
Nat = Π (A: *).
      (A → A) → (A → A) 

0 : Nat
0 = λ (A: *) (f: A → A) (x: A). x

succ : Nat → Nat
succ = λ (n: Nat) (A: *) (f: A → A) (x: A).
       f (n A f x)

1 : Nat
1 = λ (A: *) (f: A → A) (x: A). f x
-- 1 = succ 0

2 : Nat
2 = λ (A: *) (f: A → A) (x: A). f (f x)

Eq : Π(T: *). T → T → *
Eq = λ(T: *) (x: T) (y: T).
     Π(P: T → *). P x → P y

-- Reflexivity: x == x for all x
refl : Π (T: *) (x: T). Eq T x x
refl = λ(T: *) (x: T) (P: T → *) (Hx: P x). Hx

-- succ(0) == 1
1_succeeds_0 : Eq Nat (succ 0) 1
1_succeeds_0 = refl Nat 1

-- succ(1) == 2
2_succeeds_1 : Eq Nat (succ 1) 2
2_succeeds_1 = refl Nat 2

+ : Nat → Nat → Nat
+ = λ (m: Nat) (n: Nat) (A: *) (f: A → A) (x: A).
       m A f (n A f x)

-- 1 + 1 == 2
1_plus_1_equals_2 : Eq Nat (+ 1 1) 2
1_plus_1_equals_2 = refl Nat 2

