Nat : *
Nat = Π (A: *).
      (A → A) → (A → A) 

zero : Nat
zero = λ (A: *) (f: A → A) (x: A). x

succ : Nat → Nat
succ = λ (n: Nat) (A: *) (f: A → A) (x: A).
       f (n A f x)

one : Nat
one = λ (A: *) (f: A → A) (x: A). f x
-- one = succ zero

two : Nat
two = λ (A: *) (f: A → A) (x: A). f (f x)

Eq : Π(T: *). T → T → *
Eq = λ(T: *) (x: T) (y: T).
     Π(P: T → *). P x → P y

-- Reflexivity: x == x for all x
refl : Π (T: *) (x: T). Eq T x x
refl = λ(T: *) (x: T) (P: T → *) (Hx: P x). Hx

-- succ(0) == 1
one_succeeds_zero : Eq Nat (succ zero) one
one_succeeds_zero = refl Nat one

-- succ(1) == 2
two_succeeds_one : Eq Nat (succ one) two
two_succeeds_one = refl Nat two

plus : Nat → Nat → Nat
plus = λ (m: Nat) (n: Nat) (A: *) (f: A → A) (x: A).
       m A f (n A f x)

-- 1 + 1 == 2
one_plus_one_equals_two : Eq Nat (plus one one) two
one_plus_one_equals_two = refl Nat two

